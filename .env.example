# =========================================================
# SPRING PROFILE
# =========================================================
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# =========================================================
# DATABASE - POSTGRESQL / SUPABASE
# Use Supabase shared pooler transaction mode on port 6543 when session mode hits max clients.
# For PostgreSQL JDBC, disable server-side prepared statements with prepareThreshold=0.
# Example JDBC URL:
# jdbc:postgresql://aws-1-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# =========================================================
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-1-<region>.pooler.supabase.com:6543/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.<your-project-ref>
SPRING_DATASOURCE_PASSWORD=your-supabase-db-password
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=3
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=0
SPRING_DATASOURCE_PREPARE_THRESHOLD=0
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_BASELINE_ON_MIGRATE=false
SPRING_FLYWAY_BASELINE_VERSION=1

# =========================================================
# JWT
# =========================================================
APP_JWT_SECRET=change-me-super-secret-key
APP_JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
APP_JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7
APP_AUTH_REFRESH_COOKIE_NAME=refresh_token
APP_AUTH_REFRESH_COOKIE_PATH=/api/auth
APP_AUTH_REFRESH_COOKIE_DOMAIN=
APP_AUTH_REFRESH_COOKIE_SECURE=false
APP_AUTH_REFRESH_COOKIE_HTTP_ONLY=true
APP_AUTH_REFRESH_COOKIE_SAME_SITE=Lax
APP_AUTH_REFRESH_COOKIE_MAX_AGE_SECONDS=604800
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:3000,http://localhost:5173,https://*.railway.app

# =========================================================
# RATE LIMITING / REDIS
# =========================================================
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=
SPRING_DATA_REDIS_TIMEOUT=2s //thời gian phản hồi từ redis, nếu quá thì lỗi kết nối 
APP_RATE_LIMIT_ENABLED=true
APP_RATE_LIMIT_FAIL_OPEN=true
APP_RATE_LIMIT_LOGIN_WINDOW=10m
APP_RATE_LIMIT_LOGIN_EMAIL_LIMIT=5 //một email có thể thử đăng nhập tối đa 5 lần trong 10 phút
APP_RATE_LIMIT_LOGIN_CLIENT_LIMIT=20  //một client (IP) có thể thử đăng nhập tối đa 20 lần trong 10 phút
APP_RATE_LIMIT_LOGIN_PAIR_LIMIT=5 //một cặp email + client (IP) có thể thử đăng nhập tối đa 5 lần trong 10 phút
APP_RATE_LIMIT_PASSWORD_RESET_WINDOW=15m
APP_RATE_LIMIT_PASSWORD_RESET_EMAIL_LIMIT=3
APP_RATE_LIMIT_PASSWORD_RESET_CLIENT_LIMIT=10
APP_RATE_LIMIT_PASSWORD_RESET_PAIR_LIMIT=3
APP_RATE_LIMIT_PASSWORD_RESET_CONFIRM_WINDOW=15m
APP_RATE_LIMIT_PASSWORD_RESET_CONFIRM_CLIENT_LIMIT=10
APP_RATE_LIMIT_REFRESH_WINDOW=5m
APP_RATE_LIMIT_REFRESH_USER_LIMIT=20 //một user có thể thử làm mới token tối đa 20 lần trong 5 phút
APP_RATE_LIMIT_REFRESH_CLIENT_LIMIT=60 //một client (IP) có thể thử làm mới token tối đa 60 lần trong 5 phút

# =========================================================
# BOOKING RULES
# =========================================================
APP_BOOKING_PNR_EXPIRATION_MINUTES=15
APP_BOOKING_CHECKIN_OPEN_HOURS=24
APP_BOOKING_DOMESTIC_CHECKIN_CLOSE_MINUTES=40
APP_BOOKING_INTERNATIONAL_CHECKIN_CLOSE_MINUTES=60

# =========================================================
# AIRPORT IMPORT
# =========================================================
APP_AIRPORT_IMPORT_ENABLED=false
APP_AIRPORT_IMPORT_RUN_ON_STARTUP=false
APP_AIRPORT_IMPORT_BASE_URL=https://airportsapi.com
APP_AIRPORT_IMPORT_CRON=0 0 3 * * *
APP_AIRPORT_IMPORT_PAGE_SIZE=100
APP_AIRPORT_IMPORT_REQUEST_TIMEOUT_SECONDS=20
APP_AIRPORT_IMPORT_MAX_RETRIES=2
APP_AIRPORT_IMPORT_ALLOWED_TYPES=medium_airport,large_airport
APP_AIRPORT_IMPORT_REQUIRE_IATA=true
APP_AIRPORT_IMPORT_INCLUDE=country,region
APP_AIRPORT_IMPORT_FALLBACK_CITY=UNKNOWN
APP_AIRPORT_IMPORT_FALLBACK_COUNTRY=UNKNOWN
APP_AIRPORT_IMPORT_FALLBACK_TIME_ZONE=UTC
APP_AIRPORT_MARKET_DEFAULT_MARKET=VN
APP_AIRPORT_MARKET_PROXY_COUNTRY_HEADERS=CF-IPCountry,X-Vercel-IP-Country,CloudFront-Viewer-Country,X-App-Country
APP_AIRPORT_MARKET_GEOIP_SCORE=60

# =========================================================
# AIRLINE IMPORT (AirLabs — app.airline-import.*)
# Base URL is the site root (e.g. https://airlabs.co); the app calls /api/v9/airlines.
# APP_AIRLINE_IMPORT_FIELDS maps to AirLabs _fields (comma-separated). Include country_code for DB country.
# FETCH_COUNTRIES_ENRICHMENT: call /api/v9/countries (docs) to map ISO2 -> display name (airlabs.co/docs/countries).
# https://airlabs.co/docs/airlines
# =========================================================
APP_AIRLINE_IMPORT_ENABLED=false
APP_AIRLINE_IMPORT_RUN_ON_STARTUP=false
APP_AIRLINE_IMPORT_BASE_URL=https://airlabs.co
APP_AIRLABS_API_KEY=your-airlabs-api-key
APP_AIRLINE_IMPORT_CRON=0 30 3 * * *
APP_AIRLINE_IMPORT_REQUEST_TIMEOUT_SECONDS=30
APP_AIRLINE_IMPORT_MAX_RETRIES=2
APP_AIRLINE_IMPORT_REQUIRE_IATA=false
APP_AIRLINE_IMPORT_FIELDS=name,iata_code,icao_code,country_code
APP_AIRLINE_IMPORT_FETCH_COUNTRIES_ENRICHMENT=true
APP_AIRLINE_IMPORT_COUNTRIES_FIELDS=code,name

# =========================================================
# FLIGHT IMPORT (AirLabs — app.flight-import.*)
# =========================================================
APP_FLIGHT_IMPORT_ENABLED=false
APP_FLIGHT_IMPORT_RUN_ON_STARTUP=false
APP_FLIGHT_IMPORT_BASE_URL=https://airlabs.co
APP_FLIGHT_IMPORT_CRON=0 0 2 * * *
APP_FLIGHT_IMPORT_REQUEST_TIMEOUT_SECONDS=30
APP_FLIGHT_IMPORT_MAX_RETRIES=2
APP_FLIGHT_IMPORT_AIRLINE_IATA_CODES=VN,VJ,QH
APP_FLIGHT_IMPORT_DAYS_AHEAD=7

# =========================================================
# FLIGHT MAINTENANCE (coverage + cleanup — app.flight-maintenance.*)
# Scheduled via app.flight-maintenance.cron; no external flight schedule import in this cycle.
# =========================================================
APP_FLIGHT_MAINTENANCE_CRON=0 30 2 * * *
APP_FLIGHT_MAINTENANCE_RUN_ON_STARTUP=false
APP_FLIGHT_MAINTENANCE_CLEANUP_ENABLED=true

# =========================================================
# FLIGHT COVERAGE (synthetic domestic gap-fill — app.flight-coverage.*)
# Fills missing dep/arr/date for airports in include-airport-country-codes (default VN only → VN→VN).
# =========================================================
APP_FLIGHT_COVERAGE_ENABLED=true
APP_FLIGHT_COVERAGE_ROLLING_DAYS=14
APP_FLIGHT_COVERAGE_START_DATE_OFFSET_DAYS=1
APP_FLIGHT_COVERAGE_INCLUDE_AIRPORT_COUNTRY_CODES=VN
APP_FLIGHT_COVERAGE_MAX_FLIGHTS_PER_RUN=8000
APP_FLIGHT_COVERAGE_EXCLUDED_AIRLINE_CODES=
APP_FLIGHT_COVERAGE_EXCLUDED_AIRLINE_COUNTRY_CODES=
APP_FLIGHT_COVERAGE_EXCLUDED_AIRPORT_COUNTRY_CODES=

# =========================================================
# FLIGHT SEARCH FALLBACK (persist one synthetic flight when search is empty — app.flight-search-fallback.*)
# =========================================================
APP_FLIGHT_SEARCH_FALLBACK_ENABLED=true

# =========================================================
# FLIGHT MOCK DATA (global demo flights)
# Use the existing DB airlines/airports/aircraft layouts to rebuild flights
# so they no longer depend on AirLabs aircraft fallback.
# =========================================================
APP_FLIGHT_MOCK_ENABLED=false
APP_FLIGHT_MOCK_RUN_ON_STARTUP=false
APP_FLIGHT_MOCK_CRON=0 0 4 * * *
APP_FLIGHT_MOCK_FORCE_WHEN_TICKETS_EXIST=false
APP_FLIGHT_MOCK_TARGET_FLIGHT_COUNT=0
APP_FLIGHT_MOCK_FLIGHTS_PER_AIRCRAFT=3
APP_FLIGHT_MOCK_DAYS_SPAN=14
APP_FLIGHT_MOCK_START_DATE_OFFSET_DAYS=1
APP_FLIGHT_MOCK_EXCLUDED_AIRLINE_CODES=VN,VJ,QH
APP_FLIGHT_MOCK_EXCLUDED_AIRLINE_COUNTRY_CODES=VN
APP_FLIGHT_MOCK_EXCLUDED_AIRPORT_COUNTRY_CODES=

# =========================================================
# PAYMENT
# =========================================================
APP_PAYMENT_PROVIDER=payos
APP_PAYMENT_WEBHOOK_SECRET=change-me
APP_PAYMENT_RETURN_URL=http://localhost:3000/payment/success
APP_PAYMENT_CANCEL_URL=http://localhost:3000/payment/cancel
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_BASE_URL=https://api-merchant.payos.vn

# =========================================================
# MAIL
# =========================================================
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-app-password
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS_ENABLE=true
APP_MAIL_FROM=noreply@airline-booking.com

# =========================================================
# LOGGING
# =========================================================
APP_REQUEST_ID_HEADER=X-Request-Id
APP_LOG_JSON_ENABLED=false

# =========================================================
# SWAGGER
# =========================================================
APP_SWAGGER_ENABLED=true
